# Copy these names into Replit Secrets. Do not commit real values here.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ID that owns the casino. This is used for owner
# callbacks and the exploit review command.
OWNER_ID=
# If the original secret cannot be edited, use this override instead.
TELEGRAM_BOT_TOKEN_V2=

# Optional: needed only for the separate dealer-bot game flows.
DEALER_BOT_TOKEN=

# Optional payment configuration used by deposit/withdrawal features.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Optional public URL used for payment callbacks.
SERVER_URL=

# Optional: required only to inspect and buy collectible gifts on resale.
# Store TELEGRAM_API_HASH as a Replit Secret, not in a committed env file.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# The default session is stored outside this project under ~/.local/share/rollers-casino/.
# Override only with a protected path outside the project directory.
TELEGRAM_USER_SESSION_FILE=